SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters

DATABASE_PATH=authority_bridged.db

ROOT_RSA_N=replace-with-approximately-256-bit-root-rsa-modulus-decimal
ROOT_RSA_E=11
ROOT_RSA_D=replace-with-root-rsa-private-exponent-decimal
RSA_PRIME_BITS=128
RSA_PUBLIC_EXPONENT=11

EMAIL_API_PROVIDER=resend
EMAIL_API_KEY=replace-with-resend-api-key
EMAIL_FROM_ADDRESS=no-reply@example.com

OTP_EXPIRY_SECONDS=300
OTP_EMAIL_ENABLED=True
OTP_DEV_PRINT_CODE=False
MAX_EVIDENCE_SIZE_BYTES=204800

SESSION_COOKIE_NAME=authority_bridged_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_SECONDS=3600
UI_PREVIEW_ENABLED=True
FACULTY_CRYPTO_TRACE=False
